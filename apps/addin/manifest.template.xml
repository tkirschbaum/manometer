<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for the Pulse content add-in manifest (master prompt §6.2).
     scripts/build-manifest.mjs writes public/manifest.xml (APP_DOMAIN) and public/manifest.dev.xml (localhost). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>{{ADDIN_ID}}</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>{{PROVIDER}}</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="{{PRODUCT_NAME}}">
    <Override Locale="en-US" Value="{{PRODUCT_NAME}}" />
  </DisplayName>
  <Description DefaultValue="Live-Abstimmungen, Quiz und Fragen aus dem Publikum direkt auf der Folie.">
    <Override Locale="en-US" Value="Live polls, quizzes and audience questions right on the slide." />
  </Description>
  <IconUrl DefaultValue="{{ORIGIN}}/addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="{{ORIGIN}}/addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="{{ORIGIN}}/datenschutz" />
  <AppDomains>
    <AppDomain>{{ORIGIN}}</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="{{ORIGIN}}/addin/index.html" />
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
