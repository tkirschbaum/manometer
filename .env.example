# Pulse configuration. Copy to .env and fill in.
#   Local mode (your own computer):  `pnpm setup:local` writes .env for you.
#   Production (Docker):              docker compose --env-file .env -f infra/docker-compose.yml up -d --build

# --- Where Pulse is reachable -------------------------------------------------------------------
# Public host name without protocol. Caddy gets the HTTPS certificate for it; the add-in manifest
# (apps/addin/public/manifest.xml) is generated for it. Example: pulse.example.at
APP_DOMAIN=localhost:3443
# Optional full URL shown on slides (QR code, join strip) and used for links. Defaults to https://APP_DOMAIN.
# Local mode with phones: put your cloudflared tunnel URL here (see README.md).
# PUBLIC_BASE_URL=https://pulse.example.at

# --- Secrets (required in production) ---------------------------------------------------------
# Signs the short-lived dashboard/export links. At least 32 characters, random.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXPORT_TOKEN_SECRET=
# Salt for the per-deck participant hash in exports. At least 16 characters, random. Changing it later
# only affects new exports (old exports keep their pseudonyms).
PARTICIPANT_HASH_SALT=
# Password of the PostgreSQL user "pulse" (Docker stack only).
POSTGRES_PASSWORD=

# --- Database -------------------------------------------------------------------------------
# PostgreSQL connection string. The Docker stack sets it automatically from POSTGRES_PASSWORD.
# Without DATABASE_URL, Pulse uses an embedded database (PGlite) stored in PGLITE_DIR (local mode).
# DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
PGLITE_DIR=.data/pglite

# --- Server ---------------------------------------------------------------------------------
# production | development | test. `pnpm dev` sets development itself.
NODE_ENV=production
# Port and interface the Node server listens on. Docker: 3000 behind Caddy. Local mode: 3443 (HTTPS).
PORT=3000
HOST=0.0.0.0
# Local mode only: serve HTTPS with the office-addin-dev-certs certificate (~/.office-addin-dev-certs).
DEV_CERTS=false
# Alternative to DEV_CERTS: your own certificate files (PEM).
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# true when a reverse proxy (Caddy) sits in front. The Docker stack sets it.
TRUST_PROXY=false
# Override where the built apps are served from (normally not needed).
# STATIC_DIR=

# --- Data protection & operations -----------------------------------------------------------
# Responses, Q&A and leaderboards are deleted this many days after the last activity of a presentation.
RETENTION_DAYS=90
# fatal | error | warn | info | debug | trace | silent. Logs never contain IP addresses or answer texts.
LOG_LEVEL=info
# Time zone for the nightly retention job (03:30) and the backup (03:15).
TZ=Europe/Vienna
# Shown as "provider" in the add-in manifest.
ADDIN_PROVIDER=TK Webwerk
