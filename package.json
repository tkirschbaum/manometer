{
  "name": "pulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm manifest:build && pnpm -r --filter ./apps/* build",
    "start": "node apps/server/dist/index.js",
    "certs": "office-addin-dev-certs install",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "db:generate": "pnpm --filter @pulse/server db:generate",
    "db:migrate": "pnpm --filter @pulse/server db:migrate",
    "manifest:build": "node scripts/build-manifest.mjs",
    "manifest:validate": "office-addin-manifest validate apps/addin/public/manifest.xml",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
